 (modules determinism)
 (libraries morphiq_risk)
 ; Any numerical change moves the digest, so the mutation catalog
 ; (scripts/mutation/mutation.ml) runs without it.
 (enabled_if
  (<> %{profile} mutation))
 (action
  (run %{test} %{dep:determinism.digest})))

