;; Each snippet must be rejected by the type checker (exit 2); the expected
;; diagnostic is pinned so a change in why it is rejected is visible.

(rule
 (deps mix_coordinates.ml ../../lib/morphiq_risk.cma)
 (targets mix_coordinates.out)
 (action
  (with-stderr-to
   mix_coordinates.out
   (with-accepted-exit-codes
    2
    (run
     %{ocamlc}
     -I
     ../../lib/.morphiq_risk.objs/byte
     -c
     -o
     mix_coordinates.cmo
     mix_coordinates.ml)))))

(rule
 (alias runtest)
 (action
  (diff mix_coordinates.expected mix_coordinates.out)))

