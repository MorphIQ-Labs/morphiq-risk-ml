# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.3.0"
synopsis:
  "European option pricing and deterministic portfolio scenarios in OCaml"
description:
  "European pricing, certified implied volatility, typed analytic Greeks, and bounded deterministic scenario execution for BSM, Black-76, displaced Black, and Bachelier. Runtime numerical acceptance requires explicit caller-selected absolute error limits. Third-party provenance status is recorded in THIRD_PARTY_NOTICES.md."
maintainer: ["Stephen Romano <thestephenromano@gmail.com>"]
authors: ["MorphIQ Labs contributors"]
license: "Apache-2.0"
homepage: "https://github.com/MorphIQ-Labs/morphiq-risk-ml"
bug-reports: "https://github.com/MorphIQ-Labs/morphiq-risk-ml/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.3"}
  "ocaml-option-flambda"
  "zarith" {with-test}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/MorphIQ-Labs/morphiq-risk-ml.git"
