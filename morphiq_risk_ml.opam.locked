opam-version: "2.0"
name: "morphiq_risk_ml"
version: "0.3.0"
synopsis: "OCaml slice experiment rebuilding the FerroRisk European engine"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-doc}
  "cmdliner" {= "1.3.0" & with-test}
  "cppo" {= "1.8.0" & with-doc}
  "crunch" {= "4.1.0" & with-doc}
  "conf-gmp" {= "5" & with-test}
  "conf-pkg-config" {= "5" & with-test}
  "zarith" {= "1.14" & with-test}
  "dune" {= "3.24.2"}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-doc}
  "ocaml" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-config" {= "3"}
  "ocaml-option-flambda" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocaml-variants" {= "5.3.0+options"}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.8" & with-test}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "ptime" {= "1.2.0" & with-doc}
  "qcheck-alcotest" {= "0.91" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "re" {= "1.14.0" & with-test}
  "seq" {= "base" & with-doc}
  "stdlib-shims" {= "0.3.0" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "tyxml" {= "5.0.0" & with-doc}
  "uutf" {= "1.0.4" & with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
